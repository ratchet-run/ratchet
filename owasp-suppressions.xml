<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      False positives: the CVEs below affect the PostgreSQL *server* binary, not the
      JDBC client driver (org.postgresql:postgresql). OWASP Dependency Check matches
      them because they share the CPE vendor/product "postgresql:postgresql", but the
      Java driver is a TCP client and is not exposed to any of these server-side
      vulnerabilities (buffer overflows in server C code, server installer race
      conditions, server-side PL extensions, etc.).
    -->
    <suppress>
        <notes>PostgreSQL server CVEs — not applicable to JDBC client driver</notes>
        <packageUrl regex="true">^pkg:maven/org\.postgresql/postgresql@.*$</packageUrl>
        <cve>CVE-2015-0241</cve>
    </suppress>
