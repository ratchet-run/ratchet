<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>run.ratchet</groupId>
        <artifactId>ratchet-parent</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>ratchet-bom</artifactId>
    <packaging>pom</packaging>
    <name>Ratchet :: BOM</name>
    <description>Bill of Materials for Ratchet dependencies</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-store-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-encryption</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-store-mysql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-store-postgresql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-store-mongodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-coordinator-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-coordinator-postgresql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-coordinator-jms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-coordinator-infinispan</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-coordinator-hazelcast</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
              TCK submodules. The ratchet-tck aggregator (pom-packaging) is intentionally NOT in
              the BOM — pom-packaging artifacts are not useful as managed deps for consumers.
            -->
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-tck-util</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-tck-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-tck-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-tck-jakarta</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>run.ratchet</groupId>
                <artifactId>ratchet-tck-coordinator</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
