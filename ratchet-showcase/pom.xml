<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>run.ratchet</groupId>
    <artifactId>ratchet-parent</artifactId>
    <version>0.1.2-SNAPSHOT</version>
  </parent>

  <artifactId>ratchet-showcase</artifactId>
  <packaging>war</packaging>
  <name>Ratchet :: Showcase</name>
  <description>Order fulfillment showcase WAR with a live Ratchet dashboard</description>

  <properties>
    <!-- Test/dev infrastructure: never published. Guards plain mvn deploy; Central is additionally gated by excludeArtifacts in the central profile. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <showcase.server>unconfigured</showcase.server>
    <showcase.db>postgresql</showcase.db>
    <showcase.context.path>/</showcase.context.path>
    <showcase.datasource.jndi>java:jboss/datasources/RatchetDS</showcase.datasource.jndi>
    <showcase.http.port>8080</showcase.http.port>
    <showcase.java.home></showcase.java.home>
    <wildfly.management.port>9990</wildfly.management.port>
    <wildfly.https.port>18443</wildfly.https.port>
    <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-api</artifactId>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet</artifactId>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-store-core</artifactId>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-micrometer</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <version>${micrometer.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-sync</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ratchet-showcase</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-showcase-jdbc-drivers</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.mysql</groupId>
                  <artifactId>mysql-connector-j</artifactId>
                  <version>${mysql-connector.version}</version>
                  <outputDirectory>${project.build.directory}/showcase-jdbc</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>org.postgresql</groupId>
                  <artifactId>postgresql</artifactId>
                  <version>${postgresql-driver.version}</version>
                  <outputDirectory>${project.build.directory}/showcase-jdbc</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>run-showcase</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>${project.basedir}/src/showcase/scripts/run-showcase.sh</argument>
              </arguments>
              <environmentVariables>
                <SHOWCASE_BASEDIR>${project.basedir}</SHOWCASE_BASEDIR>
                <SHOWCASE_BUILD_DIR>${project.build.directory}</SHOWCASE_BUILD_DIR>
                <SHOWCASE_WAR>${project.build.directory}/${project.build.finalName}.war</SHOWCASE_WAR>
                <SHOWCASE_SERVER>${showcase.server}</SHOWCASE_SERVER>
                <SHOWCASE_DB>${showcase.db}</SHOWCASE_DB>
                <SHOWCASE_CONTEXT_PATH>${showcase.context.path}</SHOWCASE_CONTEXT_PATH>
                <SHOWCASE_DATASOURCE_JNDI>${showcase.datasource.jndi}</SHOWCASE_DATASOURCE_JNDI>
                <SHOWCASE_HTTP_PORT>${showcase.http.port}</SHOWCASE_HTTP_PORT>
                <SHOWCASE_JAVA_HOME>${showcase.java.home}</SHOWCASE_JAVA_HOME>
                <SHOWCASE_VERSION>${project.version}</SHOWCASE_VERSION>
                <WILDFLY_HOME>${wildfly.home}</WILDFLY_HOME>
                <WILDFLY_MANAGEMENT_PORT>${wildfly.management.port}</WILDFLY_MANAGEMENT_PORT>
                <WILDFLY_HTTPS_PORT>${wildfly.https.port}</WILDFLY_HTTPS_PORT>
                <PAYARA_HOME>${payara.home}</PAYARA_HOME>
                <PAYARA_HTTP_PORT>${payara.http.port}</PAYARA_HTTP_PORT>
                <PAYARA_ADMIN_PORT>${payara.admin.port}</PAYARA_ADMIN_PORT>
                <GLASSFISH_HOME>${glassfish.home}</GLASSFISH_HOME>
                <GLASSFISH_HTTP_PORT>${glassfish.http.port}</GLASSFISH_HTTP_PORT>
                <GLASSFISH_ADMIN_PORT>${glassfish.admin.port}</GLASSFISH_ADMIN_PORT>
                <OPENLIBERTY_HOME>${openliberty.home}</OPENLIBERTY_HOME>
                <OPENLIBERTY_SERVER_NAME>${openliberty.server.name}</OPENLIBERTY_SERVER_NAME>
                <OPENLIBERTY_SERVER_CONFIG_DIR>${openliberty.server.config.dir}</OPENLIBERTY_SERVER_CONFIG_DIR>
                <OPENLIBERTY_HTTP_PORT>${openliberty.http.port}</OPENLIBERTY_HTTP_PORT>
                <OPENLIBERTY_HTTPS_PORT>${openliberty.https.port}</OPENLIBERTY_HTTPS_PORT>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>postgresql</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <showcase.db>postgresql</showcase.db>
      </properties>
      <dependencies>
        <dependency>
          <groupId>run.ratchet</groupId>
          <artifactId>ratchet-store-postgresql</artifactId>
        </dependency>
        <dependency>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
          </resource>
          <resource>
            <directory>src/postgresql/resources</directory>
            <filtering>true</filtering>
          </resource>
        </resources>
      </build>
    </profile>

    <profile>
      <id>mysql</id>
      <properties>
        <showcase.db>mysql</showcase.db>
      </properties>
      <dependencies>
        <dependency>
          <groupId>run.ratchet</groupId>
          <artifactId>ratchet-store-mysql</artifactId>
        </dependency>
        <dependency>
          <groupId>com.mysql</groupId>
          <artifactId>mysql-connector-j</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
          </resource>
          <resource>
            <directory>src/mysql/resources</directory>
            <filtering>true</filtering>
          </resource>
        </resources>
      </build>
    </profile>

    <profile>
      <id>mongodb</id>
      <properties>
        <showcase.db>mongodb</showcase.db>
      </properties>
      <dependencies>
        <dependency>
          <groupId>run.ratchet</groupId>
          <artifactId>ratchet-store-mongodb</artifactId>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>wildfly-managed</id>
      <properties>
        <showcase.server>wildfly</showcase.server>
        <showcase.datasource.jndi>java:jboss/datasources/RatchetDS</showcase.datasource.jndi>
        <showcase.http.port>8080</showcase.http.port>
        <wildfly.home>${project.build.directory}/wildfly-${wildfly.version}</wildfly.home>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-wildfly-showcase</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.wildfly</groupId>
                      <artifactId>wildfly-dist</artifactId>
                      <version>${wildfly.version}</version>
                      <type>zip</type>
                      <overWrite>false</overWrite>
                      <outputDirectory>${project.build.directory}</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>payara-managed</id>
      <properties>
        <showcase.server>payara</showcase.server>
        <showcase.datasource.jndi>java:app/jdbc/RatchetDS</showcase.datasource.jndi>
        <showcase.http.port>18080</showcase.http.port>
        <payara.home>${project.build.directory}/payara6</payara.home>
        <payara.http.port>18080</payara.http.port>
        <payara.admin.port>14848</payara.admin.port>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-payara-showcase</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>fish.payara.distributions</groupId>
                      <artifactId>payara</artifactId>
                      <version>${payara.version}</version>
                      <type>zip</type>
                      <overWrite>false</overWrite>
                      <outputDirectory>${project.build.directory}</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>openliberty-managed</id>
      <properties>
        <showcase.server>openliberty</showcase.server>
        <showcase.datasource.jndi>jdbc/RatchetDS</showcase.datasource.jndi>
        <showcase.http.port>29080</showcase.http.port>
        <openliberty.home>${project.build.directory}/openliberty/wlp</openliberty.home>
        <openliberty.server.name>defaultServer</openliberty.server.name>
        <openliberty.server.config.dir>${openliberty.home}/usr/servers/${openliberty.server.name}</openliberty.server.config.dir>
        <openliberty.http.port>29080</openliberty.http.port>
        <openliberty.https.port>29443</openliberty.https.port>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-openliberty-showcase</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>io.openliberty</groupId>
                      <artifactId>openliberty-runtime</artifactId>
                      <version>${openliberty.version}</version>
                      <type>zip</type>
                      <overWrite>false</overWrite>
                      <outputDirectory>${project.build.directory}/openliberty</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>glassfish-managed</id>
      <properties>
        <showcase.server>glassfish</showcase.server>
        <showcase.datasource.jndi>java:app/jdbc/RatchetDS</showcase.datasource.jndi>
        <showcase.http.port>19080</showcase.http.port>
        <glassfish.home>${project.build.directory}/glassfish8/glassfish8</glassfish.home>
        <glassfish.http.port>19080</glassfish.http.port>
        <glassfish.admin.port>15848</glassfish.admin.port>
        <jakarta.ee.version>11.0.0</jakarta.ee.version>
        <maven.compiler.release>21</maven.compiler.release>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>${maven-enforcer-plugin.version}</version>
            <executions>
              <execution>
                <id>enforce-jdk21-for-showcase-glassfish</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[21,)</version>
                      <message>Eclipse GlassFish 8 requires JDK 21 or higher.</message>
                    </requireJavaVersion>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-glassfish-showcase</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.glassfish.main.distributions</groupId>
                      <artifactId>web</artifactId>
                      <version>${glassfish.version}</version>
                      <type>zip</type>
                      <overWrite>false</overWrite>
                      <outputDirectory>${project.build.directory}/glassfish8</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
