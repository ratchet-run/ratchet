<?xml version="1.0" encoding="UTF-8"?>
<!--
  MySQL UUID mapping for providers that need explicit conversion to canonical BINARY(16).
  Include META-INF/orm-mysql.xml only when the provider supports converters on identifiers.
  Identifier conversion is not portable across all JPA providers; integrations with native UUID
  support select their own mapping. Native queries convert UUIDs explicitly at their call sites.
-->
<entity-mappings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
                                     https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">

    <converter class="run.ratchet.store.mysql.converter.UuidByteArrayConverter"/>

    <entity class="run.ratchet.store.entity.JobEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="dependsOn"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="supersededBy"/>
    </entity>

    <entity class="run.ratchet.store.entity.ArchivedJobEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="originalJobId"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="dependedOn"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="supersededBy"/>
    </entity>

    <entity class="run.ratchet.store.entity.BatchEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="id"/>
    </entity>

    <entity class="run.ratchet.store.entity.BatchMetricsEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="batchId"/>
    </entity>

    <entity class="run.ratchet.store.entity.JobExecutionEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="jobId"/>
    </entity>

    <entity class="run.ratchet.store.entity.JobLogEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="jobId"/>
    </entity>

    <entity class="run.ratchet.store.entity.ResourcePermitEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="jobId"/>
    </entity>

    <entity class="run.ratchet.store.entity.WorkflowConditionEntity">
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="parentJobId"/>
        <convert converter="run.ratchet.store.mysql.converter.UuidByteArrayConverter" attribute-name="childJobId"/>
    </entity>

</entity-mappings>
