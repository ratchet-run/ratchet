<?xml version="1.0" encoding="UTF-8"?>
<!--
  Oracle UUID mapping for providers that need explicit conversion to canonical RAW(16).
  Include META-INF/orm-oracle.xml only when the provider supports converters on identifiers.
  Identifier conversion is not portable across all JPA providers; integrations with native UUID
  support select their own mapping. Native queries convert UUIDs explicitly at their call sites.
-->
<entity-mappings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
                                     https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">

    <converter class="run.ratchet.store.oracle.converter.UuidRawConverter"/>

    <entity class="run.ratchet.store.entity.JobEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="dependsOn"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="supersededBy"/>
    </entity>

    <entity class="run.ratchet.store.entity.ArchivedJobEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="originalJobId"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="dependedOn"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="supersededBy"/>
    </entity>

    <entity class="run.ratchet.store.entity.BatchEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="id"/>
    </entity>

    <entity class="run.ratchet.store.entity.BatchMetricsEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="batchId"/>
    </entity>

    <entity class="run.ratchet.store.entity.JobExecutionEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="jobId"/>
    </entity>

    <entity class="run.ratchet.store.entity.JobLogEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="jobId"/>
        <attributes>
            <!-- LEVEL is an Oracle reserved word; map it to a delimited identifier so the JPA
                 persist path emits "level" and agrees with ddl/oracle-schema.sql. -->
            <basic name="level">
                <column name="&quot;level&quot;" nullable="false" length="8"/>
                <enumerated>STRING</enumerated>
            </basic>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.ResourcePermitEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="jobId"/>
    </entity>

    <entity class="run.ratchet.store.entity.WorkflowConditionEntity">
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="id"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="parentJobId"/>
        <convert converter="run.ratchet.store.oracle.converter.UuidRawConverter" attribute-name="childJobId"/>
    </entity>

</entity-mappings>
