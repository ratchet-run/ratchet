<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>run.ratchet</groupId>
    <artifactId>ratchet-spring-boot-parent</artifactId>
    <version>0.3.2-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>ratchet-spring-boot-integration-tests</artifactId>
  <packaging>pom</packaging>
  <name>Ratchet :: Spring Boot :: Integration Tests</name>
  <description>Integration-test reactor for the Ratchet Spring Boot product</description>

  <properties>
    <!-- Test infrastructure: never published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <modules>
    <module>compatibility</module>
    <module>postgresql</module>
    <module>mysql</module>
    <module>oracle</module>
    <module>mongodb</module>
    <module>native-postgresql</module>
    <module>aot-preflight</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-spring-testcontainers-version</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration combine.self="override">
              <rules>
                <requireProperty>
                  <property>testcontainers.version</property>
                  <regex>2\.0\.5</regex>
                  <message>
                    Spring integration tests must use the root testcontainers.version (2.0.5).
                  </message>
                </requireProperty>
                <dependencyConvergence/>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
