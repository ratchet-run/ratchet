<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hibernate 6 SQL Server UUID bindings for Ratchet only. The store persists canonical UUID bytes
  in BINARY(16), while a host application's UUID mappings retain Hibernate's native SQL Server
  UNIQUEIDENTIFIER behavior. Hibernate 6 uses jdbc-type-code as an attribute in mapping 3.1.
-->
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping" version="3.1">

    <entity class="run.ratchet.store.entity.JobEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="createdAt"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="executionStartTime"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="executionEndTime"/>
        <attributes>
            <id name="id" jdbc-type-code="-2"><column name="job_id" length="16"/></id>
            <basic name="dependsOn" jdbc-type-code="-2"><column name="depends_on" length="16"/></basic>
            <basic name="supersededBy" jdbc-type-code="-2"><column name="superseded_by" length="16"/></basic>
            <basic name="recurringMasterId" jdbc-type-code="-2"><column name="recurring_master_id" length="16"/></basic>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.ArchivedJobEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="originalScheduledTime"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="originalCreatedAt"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="firstExecutionTime"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="completionTime"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="archivedAt"/>
        <attributes>
            <id name="id" jdbc-type-code="-2"><column name="archive_id" length="16"/></id>
            <basic name="originalJobId" jdbc-type-code="-2"><column name="original_job_id" length="16" nullable="false"/></basic>
            <basic name="dependedOn" jdbc-type-code="-2"><column name="depended_on" length="16"/></basic>
            <basic name="supersededBy" jdbc-type-code="-2"><column name="superseded_by" length="16"/></basic>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.BatchEntity">
        <attributes>
            <id name="id" jdbc-type-code="-2"><column name="batch_id" length="16"/></id>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.BatchMetricsEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="startedAt"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="completedAt"/>
        <attributes>
            <id name="batchId" jdbc-type-code="-2"><column name="batch_id" length="16"/></id>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.JobLogEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="ts"/>
        <attributes>
            <id name="id" jdbc-type-code="-2"><column name="log_id" length="16"/></id>
            <basic name="jobId" jdbc-type-code="-2"><column name="job_id" length="16" nullable="false"/></basic>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.JobExecutionEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="startedAt"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="endedAt"/>
        <attributes>
            <id name="id" jdbc-type-code="-2"><column name="id" length="16"/></id>
            <basic name="jobId" jdbc-type-code="-2"><column name="job_id" length="16" nullable="false"/></basic>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.ResourcePermitEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="acquiredAt"/>
        <attributes>
            <id name="id" jdbc-type-code="-2"><column name="id" length="16"/></id>
            <basic name="jobId" jdbc-type-code="-2"><column name="job_id" length="16" nullable="false"/></basic>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.WorkflowConditionEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="createdAt"/>
        <attributes>
            <id name="id" jdbc-type-code="-2"><column name="id" length="16"/></id>
            <basic name="parentJobId" jdbc-type-code="-2"><column name="parent_job_id" length="16" nullable="false"/></basic>
            <basic name="childJobId" jdbc-type-code="-2"><column name="child_job_id" length="16" nullable="false"/></basic>
        </attributes>
    </entity>

    <entity class="run.ratchet.store.entity.NodeEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="lastHeartbeat"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="startedAt"/>
    </entity>

    <entity class="run.ratchet.store.entity.ResourceLimitEntity">
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="createdAt"/>
        <convert converter="run.ratchet.store.converter.InstantAttributeConverter" attribute-name="updatedAt"/>
    </entity>

</entity-mappings>
