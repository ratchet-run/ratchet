<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>run.ratchet</groupId>
    <artifactId>ratchet-quarkus-parent</artifactId>
    <version>0.2.1-SNAPSHOT</version>
  </parent>

  <artifactId>ratchet-quarkus-deployment</artifactId>
  <name>Ratchet :: Quarkus Extension :: Deployment</name>

  <dependencies>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc-deployment</artifactId>
    </dependency>
    <!-- Deployment counterpart of the runtime's quarkus-hibernate-orm (extension dep-verification
         rule). The app must still declare quarkus.hibernate-orm."ratchet".packages itself; see
         QuarkusRatchetEntityManagerProvider. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-deployment</artifactId>
    </dependency>
    <!-- Deployment counterpart of the runtime's quarkus-jsonb (extension dep-verification rule). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jsonb-deployment</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <!--
            The Quarkus extension processor scans @BuildStep methods at compile time and emits
            META-INF/quarkus-build-steps.list (plus Jandex/config metadata). Quarkus loads build
            steps only from that list; without this processor the deployment jar is inert and none
            of the build steps run.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>io.quarkus</groupId>
              <artifactId>quarkus-extension-processor</artifactId>
              <version>${quarkus.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
