<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Runnable demo app exercising the ratchet-quarkus extension end to end: @QuarkusTest boots a real
    application with the extension on the classpath, backed by a profile-selected database container
    that RatchetDatabaseTestResource manages with standalone Testcontainers, and drives it over HTTP.
    This is the extension's only automated regression coverage against a live Quarkus boot;
    everything else is unit-level. Run on JDK 21.
  -->
  <parent>
    <groupId>run.ratchet</groupId>
    <artifactId>ratchet-quarkus-parent</artifactId>
    <version>0.2.1-SNAPSHOT</version>
  </parent>

  <artifactId>ratchet-quarkus-integration-tests</artifactId>
  <name>Ratchet :: Quarkus Extension :: Integration Tests</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <surefire-plugin.version>3.5.2</surefire-plugin.version>
    <rest-assured.version>5.5.1</rest-assured.version>
    <awaitility.version>4.2.2</awaitility.version>
    <!-- Demo/test module only: never published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        Testcontainers 2.0.5 requires docker-java 3.7.1, whose docker-java-api carries the
        ImageHistoryCmd type and negotiates the Docker API version. quarkus-bom (inherited from the
        parent) pins docker-java to 3.4.1, which this module-local import overrides so the
        self-managed Testcontainers client on the test classpath matches Testcontainers 2.0.5.
      -->
      <dependency>
        <groupId>com.github.docker-java</groupId>
        <artifactId>docker-java-bom</artifactId>
        <version>3.7.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <!-- The RI references jakarta.security.enterprise.SecurityContext (provided scope upstream),
         consumed via Instance<> (no-ops when absent); supply the API jar so the type resolves. -->
    <dependency>
      <groupId>jakarta.security.enterprise</groupId>
      <artifactId>jakarta.security.enterprise-api</artifactId>
      <version>3.0.0</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-quarkus-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-tck-api</artifactId>
      <version>${ratchet.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <version>${awaitility.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-oracle-free</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mssqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <!--
          Only generate-code goals, no `build`. This module is test-only (maven.deploy.skip=true) and
          its @QuarkusTest classes augment the app in-process using the per-profile db-kind supplied
          via Surefire, so a packaged standalone runner is never used. The `build` goal would package
          it from application.properties alone, where db-kind is the postgres default; under the
          db-mysql/db-oracle profiles only that database's JDBC driver is on the classpath, so the
          build goal fails to resolve a postgres driver. Dropping it removes that dead, profile-hostile
          step without losing any test coverage.
        -->
        <executions>
          <execution>
            <goals>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>db-postgres</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>run.ratchet</groupId>
          <artifactId>ratchet-store-postgresql</artifactId>
          <version>${ratchet.version}</version>
        </dependency>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>db-mysql</id>
      <dependencies>
        <dependency>
          <groupId>run.ratchet</groupId>
          <artifactId>ratchet-store-mysql</artifactId>
          <version>${ratchet.version}</version>
        </dependency>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-jdbc-mysql</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${surefire-plugin.version}</version>
            <configuration>
              <systemPropertyVariables>
                <quarkus.datasource.db-kind>mysql</quarkus.datasource.db-kind>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>db-oracle</id>
      <dependencies>
        <dependency>
          <groupId>run.ratchet</groupId>
          <artifactId>ratchet-store-oracle</artifactId>
          <version>${ratchet.version}</version>
        </dependency>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-jdbc-oracle</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${surefire-plugin.version}</version>
            <configuration>
              <systemPropertyVariables>
                <quarkus.datasource.db-kind>oracle</quarkus.datasource.db-kind>
                <!-- Activate the %oracle config profile so the Oracle-only Hibernate instant
                     mapping in application.properties applies. Tests carrying an explicit
                     @TestProfile pick this up via QuarkusRatchetTckProfile.getConfigProfile();
                     this covers the ones without a profile (e.g. the smoke test). -->
                <quarkus.test.profile>oracle</quarkus.test.profile>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>db-sqlserver</id>
      <dependencies>
        <dependency>
          <groupId>run.ratchet</groupId>
          <artifactId>ratchet-store-sqlserver</artifactId>
          <version>${ratchet.version}</version>
        </dependency>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-jdbc-mssql</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${surefire-plugin.version}</version>
            <configuration>
              <systemPropertyVariables>
                <quarkus.datasource.db-kind>mssql</quarkus.datasource.db-kind>
                <!-- Same as db-oracle: activate the %mssql config profile so the plain-TIMESTAMP
                     instant mapping applies, covering tests without an explicit @TestProfile. -->
                <quarkus.test.profile>mssql</quarkus.test.profile>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
