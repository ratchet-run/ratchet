<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>run.ratchet</groupId>
        <artifactId>ratchet-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>ratchet-tck-jakarta</artifactId>
    <name>Ratchet :: TCK :: Jakarta</name>
    <description>Jakarta-EE-container conformance contracts for Ratchet runtimes (CDI injection, CDI events, JTA enqueue)</description>

    <dependencies>
        <!-- Compile-scope: contract bodies reference RatchetTckRuntime, ProbeEvent, TckJobs, etc. -->
        <dependency>
            <groupId>run.ratchet</groupId>
            <artifactId>ratchet-tck-api</artifactId>
        </dependency>
        <dependency>
            <groupId>run.ratchet</groupId>
            <artifactId>ratchet-tck-util</artifactId>
        </dependency>

        <!--
          Provided: the container supplies the implementation. cdi-api is also pulled transitively
          via ratchet-api's module descriptor (`requires transitive jakarta.cdi;`); declaring it
          explicitly here keeps the dependency intent visible.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          Arquillian core API in compile scope (NOT test) so consuming integration suites that
          subclass these contracts inherit Arquillian transitively without re-declaring it.
          Versions are managed by arquillian-bom imported in root dependencyManagement.
          Contract bodies themselves do not import Arquillian types — @ExtendWith and @Deployment
          live on subclasses — but the consumer needs Arquillian on the classpath at run time.
        -->
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
