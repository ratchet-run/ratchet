<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>run.ratchet</groupId>
    <artifactId>ratchet-parent</artifactId>
    <version>0.3.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ratchet-arch-tests</artifactId>
  <packaging>jar</packaging>
  <name>Ratchet :: Architecture Tests</name>
  <description>
    Cross-module ArchUnit guardrails for the Ratchet reactor. Test-only module
    that depends on every module under test so the ArchUnit importer sees the
    full bytecode set in a single classpath. Two failure modes are guarded
    against: CDI bootstrap defects (CdiBeanArchitectureTest) and module
    boundary drift (LayeringArchitectureTest).
  </description>

  <properties>
    <!-- Test/dev infrastructure: never published. Guards plain mvn deploy; Central is additionally gated by excludeArtifacts in the central profile. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!--
      Test-scope dependencies on every module under analysis. ArchUnit's
      ClassFileImporter only sees classes that are on the test classpath when
      surefire forks; without these deps, rules whose subject is a coordinator
      or store-impl package match zero classes and pass vacuously. The
      per-rule subject-count assertions in each test class are the second
      line of defense, but this dep set is the primary one. The reactor-derived
      completeness test fails when a new store module is not added here.
    -->
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-security-jakarta</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-store-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-store-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-store-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-store-oracle</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-store-sqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-store-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-coordinator-common</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-coordinator-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-coordinator-jms</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-coordinator-infinispan</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-coordinator-hazelcast</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-micrometer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>run.ratchet</groupId>
      <artifactId>ratchet-otel</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Jakarta APIs needed at test-compile time for annotation references. -->
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.transaction</groupId>
      <artifactId>jakarta.transaction-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        SpotBugs and the SBOM plugin add nothing for a test-only module:
        there is no production bytecode to scan and no shipped artifact to
        list. JaCoCo is similarly noise. Disable each so `mvn verify` stays
        fast and CI does not spend cycles on a no-op.
      -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
