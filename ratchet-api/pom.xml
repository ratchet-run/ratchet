<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>run.ratchet</groupId>
        <artifactId>ratchet-parent</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>ratchet-api</artifactId>
    <name>Ratchet :: API</name>
    <description>Public API, events, enums, and SPI interfaces for Ratchet job scheduler
    </description>

    <dependencies>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Ratchet is pre-1.0 and intentionally permits breaking API changes. Generate the report
            with -Dratchet.api.compatibility. Once a release is chosen as a stability baseline, add
            -Dratchet.api.compatibility.enforce=true to turn incompatibilities into failures.
        -->
        <profile>
            <id>api-compatibility</id>
            <activation>
                <property>
                    <name>ratchet.api.compatibility</name>
                </property>
            </activation>
            <properties>
                <ratchet.api.compatibility.enforce>false</ratchet.api.compatibility.enforce>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>0.26.1</version>
                        <configuration>
                            <parameter>
                                <oldVersionPattern>\d+\.\d+\.\d+</oldVersionPattern>
                                <includeSnapshots>false</includeSnapshots>
                                <onlyModified>true</onlyModified>
                                <accessModifier>public</accessModifier>
                                <excludes>
                                    <exclude>run.ratchet.api.internal</exclude>
                                </excludes>
                                <breakBuildOnBinaryIncompatibleModifications>${ratchet.api.compatibility.enforce}</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>${ratchet.api.compatibility.enforce}</breakBuildOnSourceIncompatibleModifications>
                            </parameter>
                        </configuration>
                        <executions>
                            <execution>
                                <id>report-public-api-compatibility</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
