<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

  <defaultProtocol type="Servlet 5.0"/>

  <engine>
    <property name="deploymentExportPath">target/deployments</property>
  </engine>

  <container qualifier="wildfly-managed" default="true">
    <configuration>
      <property name="jbossHome">${project.build.directory}/wildfly-${wildfly.version}</property>
      <property name="serverConfig">standalone.xml</property>
      <property name="javaVmArguments">
        -Xms512m -Xmx1024m
        -Djboss.socket.binding.port-offset=20000
        ${jacoco.it.argLine}
        -Dratchet.test.db.url=${ratchet.test.db.url}
        -Dratchet.test.db.username=${ratchet.test.db.username}
        -Dratchet.test.db.password=${ratchet.test.db.password}
        -Dratchet.test.db.driver=${ratchet.test.db.driver}
        -Dratchet.test.db.driver.name=${ratchet.test.db.driver.name}
        -Dratchet.test.db.type=${ratchet.test.db.type}
        -Dratchet.test.mongo.uri=${ratchet.test.mongo.uri}
        -Dratchet.test.mongo.database=${ratchet.test.mongo.database}
        -DPOLLER_DEEP_IDLE_THRESHOLD_MS=5000
        -DPOLLER_DEEP_IDLE_DELAY_MS=1000
        -DPOLLER_MAX_DELAY_MS=2000
      </property>
      <property name="managementPort">29990</property>
      <property name="allowConnectingToRunningServer">false</property>
    </configuration>
  </container>

  <container qualifier="payara-managed">
    <configuration>
      <property name="payaraHome">${payara.home}</property>
      <property name="domain">domain1</property>
      <property name="adminPort">4848</property>
      <!--
        Payara 6.x ships with admin/<empty> as the DAS credentials AND requires
        Basic-Auth on the management endpoint (sending no Authorization header
        also returns 401, even from localhost). The Arquillian-Payara adapter
        only emits an Authorization header when authorisation=true is set,
        and Validate.notNull(adminUser) trips during config validation if
        authorisation=true is set without an explicit adminUser. Set all
        three: authorisation flag on, user "admin", empty password.
      -->
      <property name="authorisation">true</property>
      <property name="adminUser">admin</property>
      <property name="adminPassword"></property>
      <property name="allowConnectingToRunningServer">false</property>
      <property name="outputToConsole">true</property>
      <property name="serverSystemProperties">
        ratchet.test.db.type=${ratchet.test.db.type}:testsuite.profile=${testsuite.profile}
      </property>
    </configuration>
  </container>

  <container qualifier="glassfish-managed">
    <configuration>
      <property name="glassFishHome">${glassfish.home}</property>
      <property name="domain">domain1</property>
      <property name="adminPort">4848</property>
      <property name="allowConnectingToRunningServer">false</property>
      <property name="outputToConsole">true</property>
      <!--
        Neither systemProperties nor postBootCommands works in omnifish 2.1.3:
          - systemProperties: even with newline-delimited entries, the
            connector emits a single `<jvm-options>` element with all keys
            joined by a space (e.g. `-Dk1=v1 k2=v2`).
          - postBootCommands: throws UnsupportedOperationException at
            startup AND @AfterSuite teardown (immutable-list mutation).

        ratchet.test.db.type and testsuite.profile must reach the
        in-container WAR (read by @EnabledIfSystemProperty, evaluated in
        the deployed WAR's classloader). The pom.xml's pre-integration-test
        antrun edits domain.xml directly via <replaceregexp> to inject
        them as proper <jvm-options> entries.
      -->
    </configuration>
  </container>

  <container qualifier="openliberty-managed">
    <configuration>
      <property name="wlpHome">${openliberty.home}</property>
      <property name="serverName">${openliberty.server.name}</property>
      <property name="httpPort">${openliberty.http.port}</property>
      <property name="javaVmArguments">
        -Xms512m -Xmx1024m
        ${jacoco.it.argLine}
        -Dratchet.test.db.url=${ratchet.test.db.url}
        -Dratchet.test.db.username=${ratchet.test.db.username}
        -Dratchet.test.db.password=${ratchet.test.db.password}
        -Dratchet.test.db.driver=${ratchet.test.db.driver}
        -Dratchet.test.db.driver.name=${ratchet.test.db.driver.name}
        -Dratchet.test.db.type=${ratchet.test.db.type}
        -Dratchet.test.mongo.uri=${ratchet.test.mongo.uri}
        -Dratchet.test.mongo.database=${ratchet.test.mongo.database}
        -DPOLLER_DEEP_IDLE_THRESHOLD_MS=5000
        -DPOLLER_DEEP_IDLE_DELAY_MS=1000
        -DPOLLER_MAX_DELAY_MS=2000
      </property>
      <property name="allowConnectingToRunningServer">false</property>
      <property name="outputToConsole">true</property>
      <property name="serverStartTimeout">90</property>
      <property name="appDeployTimeout">60</property>
    </configuration>
  </container>

</arquillian>
