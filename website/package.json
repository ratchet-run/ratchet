{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "start": "vitepress dev docs",
    "check:tck-docs": "node scripts/check-docs.mjs",
    "check:drain-docs": "node scripts/check-drain-docs.mjs",
    "check:operator-docs": "node scripts/check-operator-docs.mjs",
    "check:docs": "npm run check:tck-docs && npm run check:drain-docs && npm run check:operator-docs",
    "docs:sync-config-reference": "node scripts/check-operator-docs.mjs --write",
    "prebuild": "npm run check:docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "serve": "vitepress preview docs",
    "a11y": "node a11y/scan.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1",
    "shiki": "^4.4.3",
    "vitepress": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0"
  }
}
