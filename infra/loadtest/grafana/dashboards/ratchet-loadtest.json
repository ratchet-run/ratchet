{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ratchet_jobs_completed_total[1m]))",
          "legendFormat": "completed/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ratchet_jobs_failed_total[1m]))",
          "legendFormat": "failed/sec",
          "refId": "B"
        }
      ],
      "title": "Throughput",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ratchet_jobs_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ratchet_jobs_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ratchet_jobs_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Execution Latency",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "max(ratchet_store_nodes_active)",
          "legendFormat": "active nodes",
          "refId": "A"
        }
      ],
      "title": "Cluster Size",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "max(ratchet_store_jobs{status=\"PENDING\"})",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "expr": "max(ratchet_store_jobs{status=\"RUNNING\"})",
          "legendFormat": "running",
          "refId": "B"
        },
        {
          "expr": "max(ratchet_store_jobs_ready)",
          "legendFormat": "ready",
          "refId": "C"
        }
      ],
      "title": "Queue Depth",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "changes(ratchet_node_start_time_seconds[10m])",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "Node Restarts",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "max(ratchet_pg_connections_total{datname=\"ratchet\"}) or max(mysql_global_status_threads_connected)",
          "legendFormat": "db connections",
          "refId": "A"
        },
        {
          "expr": "max(ratchet_pg_connections_active{datname=\"ratchet\"}) or max(mysql_global_status_threads_running)",
          "legendFormat": "active db workers",
          "refId": "B"
        },
        {
          "expr": "max(ratchet_pg_connections_waiting{datname=\"ratchet\"}) or max(mysql_global_status_innodb_row_lock_current_waits)",
          "legendFormat": "waiting backends / row locks",
          "refId": "C"
        },
        {
          "expr": "max(ratchet_pg_waiting_locks_waiting{datname=\"ratchet\"}) or sum(rate(mysql_global_status_innodb_row_lock_waits[1m]))",
          "legendFormat": "lock waits / sec",
          "refId": "D"
        },
        {
          "expr": "max(ratchet_store_jobs{status=\"PENDING\"})",
          "legendFormat": "pending jobs",
          "refId": "E"
        }
      ],
      "title": "DB Pressure",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (execution_type) (rate(ratchet_poller_claimed_jobs_total[1m]))",
          "legendFormat": "claimed {{ execution_type }}/sec",
          "refId": "A"
        },
        {
          "expr": "sum by (execution_type) (rate(ratchet_store_claim_transient_failures_total[1m]))",
          "legendFormat": "claim conflicts {{ execution_type }}/sec",
          "refId": "B"
        }
      ],
      "title": "Claim Pressure",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(ratchet_store_finalization_retries_total[1m])) or on() vector(0)",
          "legendFormat": "finalization retries {{ type }}/sec",
          "refId": "A"
        },
        {
          "expr": "sum by (type) (rate(ratchet_store_finalization_minimal_success_total[1m])) or on() vector(0)",
          "legendFormat": "minimal success {{ type }}/sec",
          "refId": "B"
        },
        {
          "expr": "sum by (type) (rate(ratchet_store_finalization_stuck_total[1m])) or on() vector(0)",
          "legendFormat": "stuck finalization {{ type }}/sec",
          "refId": "C"
        },
        {
          "expr": "sum by (execution_type, gate_status) (rate(ratchet_submission_gate_rejections_total[1m])) or on() vector(0)",
          "legendFormat": "gate {{ execution_type }} {{ gate_status }}/sec",
          "refId": "D"
        }
      ],
      "title": "Finalization And Gates",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(ratchet_wakeup_local_total[1m])) or on() vector(0)",
          "legendFormat": "local {{ source }}/sec",
          "refId": "A"
        },
        {
          "expr": "sum by (transport, outcome) (rate(ratchet_wakeup_cluster_publish_total[1m])) or on() vector(0)",
          "legendFormat": "publish {{ transport }} {{ outcome }}/sec",
          "refId": "B"
        },
        {
          "expr": "sum by (transport, outcome) (rate(ratchet_wakeup_cluster_receive_total[1m])) or on() vector(0)",
          "legendFormat": "receive {{ transport }} {{ outcome }}/sec",
          "refId": "C"
        }
      ],
      "title": "Wakeups",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 40,
  "tags": ["ratchet", "loadtest"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Ratchet Load Test",
