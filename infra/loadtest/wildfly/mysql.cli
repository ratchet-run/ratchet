embed-server --std-out=echo --server-config=standalone.xml

module add --name=com.mysql \
  --resources=/opt/jboss/ratchet/drivers/mysql.jar

/subsystem=datasources/jdbc-driver=mysql:add( \
  driver-name=mysql, \
  driver-module-name=com.mysql, \
  driver-class-name=com.mysql.cj.jdbc.Driver)

data-source add \
  --name=RatchetDS \
  --jndi-name=java:jboss/datasources/RatchetDS \
  --driver-name=mysql \
  --connection-url=${env.DB_URL:jdbc:mysql://mysql:3306/ratchet?sessionVariables=transaction_isolation='READ-COMMITTED'} \
  --user-name=${env.DB_USERNAME:ratchet} \
  --password=${env.DB_PASSWORD:ratchet} \
  --enabled=true \
  --use-java-context=true \
  --min-pool-size=${env.DB_MIN_POOL_SIZE:5} \
  --max-pool-size=${env.DB_MAX_POOL_SIZE:100} \
  --transaction-isolation=TRANSACTION_READ_COMMITTED

stop-embedded-server
